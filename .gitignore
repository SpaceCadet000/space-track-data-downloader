# PROJECT NAME: Space-Track Data Downloader
# FILE:         .gitignore
# PATH:         space-track-data-downloader/.gitignore
# AUTHOR:       Sooraj Suresh
# DATE:         May 2026
# VERSION:      1.0.0
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DESCRIPTION:  Defines generated files, local environments, cache folders, secrets, 
#               and downloaded data that Git should ignore.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Python virtual environment
.venv/
venv/
env/
ENV/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Python build/distribution files
build/
dist/
*.egg-info/
.eggs/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Test/cache folders
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Space-Track credentials / secrets
.env
.env.*
*.env
credentials.json
cookies.txt
*.cookie
*.cookies

# Space-Track downloaded data
downloads/
*.tle
*.csv
*.json
*.xml
*.kvn
*.html

# Keep example/config documentation if added in later versions
!example*.json
!sample*.json

# Metadata generated by this downloader
*_meta.json

# Cache folder for future model definitions
.spacetrack_cache/

# VSCodium / VS Code
.vscode/
.history/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo